# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/points_system?schema=public"

# Server Configuration
PORT=3000
NODE_ENV=development

# Snapshot Configuration
SNAPSHOT_CRON_SCHEDULE="0 0 * * *"  # Daily at 00:00 UTC
DATA_SOURCE_URL="http://localhost:8080/graphql"  # Fallback for backward compatibility

# Goldsky Configuration (MANTRA Chain)
# Get your subgraph URL from: https://app.goldsky.com/dashboard
# Format: https://api.goldsky.com/api/public/project_<PROJECT_ID>/subgraphs/<SUBGRAPH_NAME>/<VERSION>/gn
GOLDSKY_SUBGRAPH_URL="https://api.goldsky.com/api/public/project_<YOUR_PROJECT_ID>/subgraphs/fluxtra-mantra/1.0.0/gn"
GOLDSKY_API_KEY=""  # Optional: Only needed for private subgraphs

# Logging
LOG_LEVEL=info

# Season Configuration
DEFAULT_SEASON_START="2026-01-01T00:00:00Z"
